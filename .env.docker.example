# ==========================================
# Configuración de Docker para Fiambrería Costanera POS
# ==========================================

# Credenciales de PostgreSQL
POSTGRES_DB=vertex_pos
POSTGRES_USER=posuser
POSTGRES_PASSWORD=TuPasswordSeguro123

# Secreto de sesión (genera uno seguro con: openssl rand -base64 32)
AUTH_SECRET=genera-una-clave-secreta-larga-y-aleatoria-aqui

# URL principal de acceso (tu dominio HTTPS de Cloudflare o la IP local de la notebook)
APP_URL=http://192.168.1.50:3000

# Tamaño máximo de subida de imágenes de productos (en MB)
MAX_PRODUCT_IMAGE_UPLOAD_MB=5

# Primer Administrador (se crea automáticamente sólo cuando la base de datos está vacía)
INIT_ADMIN_NAME=Administrador
INIT_ADMIN_EMAIL=admin@mifiambreria.com
INIT_ADMIN_PASSWORD=CambiarPassword123

# ==========================================
# Acceso por Internet: Cloudflare Tunnel (opcional)
# ==========================================
# Para activar el contenedor cloudflared automáticamente, define COMPOSE_PROFILES=cloudflare
# y pega el token de tu túnel de Cloudflare Zero Trust.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# ==========================================
# Copias de Seguridad Automáticas (Local + Nube rclone)
# ==========================================
# Días de retención de backups en el SSD local
BACKUP_RETENTION_DAYS=30

# Destino opcional en rclone (ej. gdrive:FiambreriaBackups, onedrive:BackupsPOS, dropbox:BackupsPOS)
RCLONE_REMOTE=
BACKUP_CLOUD_RETENTION_DAYS=60
