# ==========================================
# Configuración de Docker para Fiambrería Costanera POS
# ==========================================

# Credenciales de PostgreSQL
POSTGRES_DB=vertex_pos
POSTGRES_USER=posuser
POSTGRES_PASSWORD=TuPasswordSeguro123

# Secreto de sesión (genera uno seguro con: openssl rand -base64 32)
AUTH_SECRET=genera-una-clave-secreta-larga-y-aleatoria-aqui

# URL de acceso de la tienda (la IP de tu notebook en la red local)
APP_URL=http://192.168.1.50:3000

# Tamaño máximo de subida de imágenes de productos (en MB)
MAX_PRODUCT_IMAGE_UPLOAD_MB=5
